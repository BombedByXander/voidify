{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"tabWidth": 4,
	"printWidth": 120,
	"semi": true,
	"singleQuote": false,
	"trailingComma": "all",
	"ignorePatterns": [
		"**/.output",
		"**/.nitro",
		"**/.wrangler",
		"**/dist",
		"**/package.json",
		"pnpm-lock.yaml",
		".github",
		"**/*.yml",
		"**/*.yaml"
	]
}
