# Copy to .dev.vars for local `wrangler dev`. Any stable string works locally;
# production uses `wrangler secret put ACCOUNT_HASH_SECRET`.
ACCOUNT_HASH_SECRET="dev-only-not-a-real-secret"

# Optional. Where the nightly spike check posts; unset means it stays quiet.
# Production uses `wrangler secret put ALERT_WEBHOOK_URL`.
# ALERT_WEBHOOK_URL="http://127.0.0.1:9099/hook"

# Telegram only: the bot's sendMessage endpoint plus the chat to post into.
# ALERT_WEBHOOK_URL="https://api.telegram.org/bot<token>/sendMessage"
# ALERT_CHAT_ID="123456789"
